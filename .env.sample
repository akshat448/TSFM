# Copy this to .env and fill in real values. .env is loaded automatically by
# scripts/train_cluster.py (via python-dotenv) if present; on the cluster you
# can instead just `export` these in your shell/sbatch script -- either
# works, wandb.init() reads WANDB_API_KEY from the environment either way.
#
# Get your key from https://wandb.ai/authorize
WANDB_API_KEY=
WANDB_PROJECT=chisco-tsfm
WANDB_ENTITY=
